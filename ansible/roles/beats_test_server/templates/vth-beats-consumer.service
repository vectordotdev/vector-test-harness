[Unit]
Description=Beats protocol receiver for correctness cases
After=network-online.target

[Service]
User=logstash
Group=logstash
Environment="LS_JAVA_OPTS=-Xms256m -Xmx256m"
ExecStart=/usr/share/logstash/bin/logstash --path.settings /etc/vth-beats-consumer -f /etc/vth-beats-consumer/pipeline.conf
TimeoutStopSec=60
